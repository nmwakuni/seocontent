# Database (Required)
# For local development:
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# For Docker: postgresql://seocontent:seocontent_password@postgres:5432/seocontent

# Docker Database Configuration (only needed for docker-compose)
POSTGRES_USER="seocontent"
POSTGRES_PASSWORD="seocontent_password"
POSTGRES_DB="seocontent"
POSTGRES_PORT="5432"

# Application Port (for Docker)
APP_PORT="3000"

# Better Auth (Required)
BETTER_AUTH_SECRET="your-secret-key-here" # Generate with: openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000" # Change to your production URL
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Optional - for social login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Claude AI API (Required for content generation)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend (Optional - for email notifications)
RESEND_API_KEY="re_..."

# Pesapal (Optional - for payments)
PESAPAL_CONSUMER_KEY="your-pesapal-consumer-key"
PESAPAL_CONSUMER_SECRET="your-pesapal-consumer-secret"
PESAPAL_IPN_URL="https://yourdomain.com/api/payments/pesapal/ipn"
PESAPAL_CALLBACK_URL="https://yourdomain.com/api/payments/pesapal/callback"
PESAPAL_ENVIRONMENT="sandbox" # or "live" for production
NEXT_PUBLIC_PESAPAL_CONSUMER_KEY="your-pesapal-consumer-key"

# M-Pesa (Optional - for mobile money payments)
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_SHORTCODE="your-mpesa-shortcode"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"
MPESA_ENVIRONMENT="sandbox" # or "live" for production

# Pricing (in KES - Kenyan Shillings)
PRICE_STARTER_KES="9999" # KES 9,999 (~$99 USD)
PRICE_PRO_KES="29999" # KES 29,999 (~$299 USD)
PRICE_ENTERPRISE_KES="custom"
